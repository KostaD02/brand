{
  "name": "@kostad/brand",
  "version": "1.0.0",
  "description": "Personal branding",
  "keywords": [
    "brand",
    "design-tokens",
    "design-system",
    "scss",
    "css"
  ],
  "homepage": "https://github.com/KostaD02/brand#readme",
  "bugs": {
    "url": "https://github.com/KostaD02/brand/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KostaD02/brand.git"
  },
  "license": "MIT",
  "author": "Konstantine Datunishvili <konstantineda@datunishvili.ge>",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "style": "./dist/kostad-brand.css",
  "sass": "./scss/main.scss",
  "exports": {
    ".": {
      "sass": "./scss/main.scss",
      "style": "./dist/kostad-brand.css",
      "default": "./dist/kostad-brand.css"
    },
    "./css": "./dist/kostad-brand.css",
    "./css/min": "./dist/kostad-brand.min.css",
    "./tokens.json": "./dist/kostad-brand-tokens.json",
    "./scss": "./scss/main.scss",
    "./scss/*": "./scss/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scss",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsx scripts/build.ts",
    "build:silent": "tsx scripts/build.ts --silent",
    "watch": "tsx scripts/build.ts --watch",
    "watch:silent": "tsx scripts/build.ts --watch --silent",
    "docs:run": "pnpm run build:silent && storybook dev -p 2222",
    "docs:build": "pnpm run build && storybook build -o storybook-static",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run lint:ts && pnpm run lint:scss",
    "lint:ts": "eslint .",
    "lint:scss": "stylelint \"scss/**/*.scss\"",
    "lint:fix": "eslint . --fix && stylelint \"scss/**/*.scss\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major"
  },
  "peerDependencies": {
    "sass": ">=1.79"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/html-vite": "^10.5.8",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "sass": "^1.102.0",
    "storybook": "^10.5.8",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": [
        "pnpm run lint",
        "pnpm run typecheck"
      ],
      "after:bump": "pnpm run build"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "docs",
              "section": "Documentations"
            },
            {
              "type": "refactor",
              "section": "Refactors"
            }
          ]
        }
      }
    }
  }
}
