{
  "name": "@kostad02/brand",
  "version": "1.0.0",
  "description": "Personal branding",
  "homepage": "https://github.com/KostaD02/brand#readme",
  "bugs": {
    "url": "https://github.com/KostaD02/brand/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KostaD02/brand.git"
  },
  "license": "MIT",
  "author": "Konstantine Datunishvili <konstantineda@datunishvili.ge>",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "prepare": "husky",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run lint:ts && pnpm run lint:scss",
    "lint:ts": "eslint .",
    "lint:scss": "stylelint \"scss/**/*.scss\"",
    "lint:fix": "eslint . --fix && stylelint \"scss/**/*.scss\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
